{
  "name": "ceo-agent-service",
  "version": "0.1.0",
  "description": "Local-first DingTalk executive auto-reply service powered by dws, Codex, graphify, and SQLite.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/callzhang/ceo-agent-service.git"
  },
  "dependencies": {
    "@tigrisdata/storage": "^3.13.0"
  },
  "scripts": {
    "build:workbench": "npm run build --prefix frontend",
    "dev:local": "ceo-agent run",
    "test": "npm run lint:local && npm run test:local && npm run test:workbench",
    "lint:local": "${CEO_RUFF:-$HOME/miniforge3/bin/ruff} check app tests",
    "test:local": "${CEO_PYTHON:-$HOME/miniforge3/bin/python} -m pytest",
    "test:workbench": "npm run test --prefix frontend -- --run"
  }
