# Local knowledge workspace. This directory is read by Codex and graphify.
CEO_WORKSPACE=$HOME/Documents/memory

# Local runtime state. Keep this file out of Git.
CEO_WORKER_DB=$HOME/Library/Application Support/ceo-agent-service/auto-reply.sqlite3

# Dry-run is the safe default. Set CEO_DRY_RUN=0 only after reviewing behavior.
CEO_DRY_RUN=1

# Fast path routing.
CEO_PRODUCER_INTERVAL_SECONDS=60
CEO_CONSUMER_POLL_INTERVAL_SECONDS=10
CEO_MEETING_PRODUCER_INTERVAL_SECONDS=60
CEO_MEETING_CONSUMER_POLL_INTERVAL_SECONDS=10
CEO_MEETING_SETTLE_SECONDS=600
CEO_POLL_INTERVAL_SECONDS=30
CEO_BATCH_SECONDS=120
CEO_CORPUS_DIR=./data/corpus
CEO_WORK_PROFILE_PATH=./data/work-profile/work_profile.md
CEO_DEVELOPER_PROMPT_TEMPLATE_PATH=./data/prompts/developer_prompt.md
CEO_USER_PROMPT_TEMPLATE_PATH=./data/prompts/user_prompt.md
CEO_AUDIT_RULES_TEMPLATE_PATH=./data/prompts/audit_rules.md

# Codex model/provider selection. Defaults avoid inheriting the user's
# global ~/.codex/config.toml model from the service runtime.
# CEO_CODEX_MODEL=gpt-5.5
# CEO_CODEX_MODEL_REASONING_EFFORT=medium
# CEO_CODEX_MODEL_PROVIDER=

# Service-owned MCP transports. Setup copies the committed seed to this editable
# local manifest; delete optional server entries that this deployment does not use.
CEO_SERVICE_MCP_CONFIG_PATH=data/config/service-mcp.json
MEMORY_CONNECTOR_URL=
CONNECTOR_API_KEY=
MEMORY_CONNECTOR_AUTH_TYPE=mcp_access_token
MEMORY_CONNECTOR_CONTENT_TYPE=application/json
CEO_XIAOQING_MCP_COMMAND=
CEO_XIAOQING_MCP_ARGS_JSON=[]

# Reviewed exact MCP read/write capability registry. Unknown tools fail closed.
# CEO_AGENT_MCP_EFFECTS_PATH=./config/mcp-tool-effects.json

CEO_DWS_TRANSIENT_RETRY_ATTEMPTS=3
CEO_DWS_TRANSIENT_RETRY_DELAY_SECONDS=1.0
CEO_TASK_WORK_ITEM_INTERVAL_SECONDS=60
CEO_TASK_DAILY_INTERVAL_SECONDS=86400
CEO_TASK_FOLLOW_UP_INTERVAL_SECONDS=60

# OKR review live source. Default is dingteam_web and requires an explicit
# command that returns live 叮当OKR JSON. Prefer the dedicated headless profile
# and token cache so scheduled runs do not depend on an always-open Chrome tab.
# Use agoal only when this tenant's OKR data is actually exposed through
# Agoal objective APIs.
CEO_OKR_SOURCE_KIND=dingteam_web
CEO_OKR_OBJECTIVE_RULE_ID=
CEO_OKR_LIVE_SOURCE_COMMAND=.venv/bin/python /Users/derek/.agents/skills/dingtang-okr-review/scripts/dingteam_okr_browser_source.py fetch --user-id {user_id} --period-label {period_label}

# CEO-2 management OKR weekly report. The main service checks this every task
# maintenance pass, but only runs once on Sunday at/after the configured hour.
CEO_WEEKLY_OKR_REPORT_ENABLED=1
CEO_WEEKLY_OKR_REPORT_HOUR=18
CEO_WEEKLY_OKR_RETRY_SECONDS=1800
CEO_WEEKLY_OKR_GROUP_NAME="CEO-2 管理群"
CEO_WEEKLY_OKR_WIKI_NAME="🎯  目标与执行"
CEO_WEEKLY_OKR_FOLDER_NAME="管理者 OKR 进度周报"

# Producer recovery routing. Fast path still runs every producer interval; these
# values control the slower fallback scans that protect against missed messages.
MESSAGE_RECOVERY_INTERVAL=5m
SINGLE_CHAT_READ_RECOVERY_WINDOW=24h
SINGLE_CHAT_READ_RECOVERY_LIMIT=50
GROUP_READ_RECOVERY_WINDOW=24h
GROUP_READ_RECOVERY_LIMIT=3

# Principal/persona configuration.
CEO_PRINCIPAL_NAME=Executive
USER_ALIAS=Executive
CEO_MENTION_ALIASES=@CEO,@Executive
# Names that coworkers may mention to address this deployment's Agent.
# Replace these for each principal; comma-separate multiple names.
CEO_AGENT_NAMES=CEO助手
DOCUMENT_EXTRACTION_IDS=Executive
CEO_ASSISTANT_SIGNATURE="(via agent)"
CEO_HANDOFF_ACK="I will ask Executive to take a look. (via agent)"
CEO_FORBIDDEN_PATH_PREFIXES=$HOME/

# Counterparty feedback links. Leave empty to disable.
# If enabled, deploy this repo's Vercel API routes to your own Vercel project,
# set FEEDBACK_SPIKE_SECRET on that project, then put your deployment root here.
# Do not reuse another operator's feedback service URL.
CEO_FEEDBACK_SPIKE_VERCEL_BASE_URL=

# Prompt user variables. These fill <var: ...> tags in prompt templates.
# Identity variables such as principal/handoff_name are derived from the
# system config above instead of being duplicated here.
CEO_PROMPT_VAR_RESPONSIBILITY_SUMMARY="Reply only when the message clearly requires the principal's decision or responsibility."
CEO_PROMPT_VAR_FORBIDDEN_REPLY_TEXT_TERMS=
CEO_PROMPT_VAR_OA_APPROVAL_RULES=management/OA/钉钉审批审阅原则.md

# Optional handoff notification settings.
CEO_DING_ROBOT_CODE=
CEO_DING_ROBOT_NAME=磊哥
CEO_DING_RECEIVER_USER_ID=

# Required explicit opt-in for live sends.
CEO_LIVE_SEND_BLOCKERS_ACCEPTED=

# --- Feishu CLI channel (diagnostics/read path; live send disabled by default) ---
CEO_FEISHU_CLI_BINARY=lark
CEO_FEISHU_LIVE_SEND_ENABLED=0

# --- WeChat personal-account channel (read-first, disabled by default) ---
CEO_WECHAT_READER_ENABLED=0
CEO_WECHAT_SENDER_ENABLED=0
CEO_WECHAT_POLL_INTERVAL_SECONDS=15
CEO_WECHAT_READER_TIMEOUT_SECONDS=120
CEO_WECHAT_SNAPSHOT_DIR=data/wechat-snapshots
# Private, chmod-600 hex passphrase captured once via the shadow-copy + CCKeyDerivationPBKDF flow.
CEO_WECHAT_PASSPHRASE_FILE=~/.config/wx_read/passphrase.hex
# Private, chmod-700 decrypted mirror (holds plaintext message data; purge on disable).
CEO_WECHAT_MIRROR_DIR=~/.cache/wx_read/plain
