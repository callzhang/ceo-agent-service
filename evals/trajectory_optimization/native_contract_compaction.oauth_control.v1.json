  "harness_sources": {
    "runner": "import sys,os,json,secrets,subprocess,tomllib,hashlib\nfrom pathlib import Path\nfrom unittest.mock import patch\nsys.path.insert(0,'/private/tmp/ceo-native-schema-current-main')\nfrom app.config import load_env_file\nfrom app.consumer_agent import consumer_developer_sections,audit_developer_sections\nfrom app.prompt_composition import render_prompt_sections\nfrom app.native_agent_output import native_developer_assembly\nfrom app.prompt_composition import load_prompt_configuration\nfrom app.audit_rules import render_audit_rules\nfrom app.store import AgentRole\nfrom app.agent_contracts import ConsumerAgentResult\nfrom app.reviewed_candidates import candidate_digest\nfrom app.agent_runtime_config import load_runtime_config\nfrom app.codex_runtime_adapter import CodexRuntimeAdapter\nfrom app.native_agent_output import native_output_schema_path,native_task_prompt,parse_native_output\nfrom app.wechat.codex_safety import make_role_agent_command,ControlledCliConfig,disable_automatic_review\nfrom app.agent_runtime_contracts import CredentialMode\nroot=Path(__file__).parent;load_env_file(Path('/Users/derek/Services/ceo-agent-service/.env'))\nconfig=load_runtime_config(os.environ);frozen_configurations={role:load_prompt_configuration(create_missing=False,role=role) for role in ('consumer','audit')};frozen_audit_rules=render_audit_rules(AgentRole.AUDIT,create_missing=False);candidate=ConsumerAgentResult.model_validate({'outcome':'no_action','summary':'Anonymous read-only provider compatibility probe; no business action.','proposal':None,'error':{'code':'','retryable':False,'authorization_required':False},'risk':'low','confidence':1.0,'rule_coverage':1.0,'information_completeness':1.0});digest=candidate_digest(candidate);adapter=CodexRuntimeAdapter(root,config);records=[]\nfor variant in ('baseline','compact'):\n route_name='codex_oauth';route=next(x for x in config.routes if x.name==route_name);server_route=route_name+'.'+variant\n for role in ('consumer','audit'):\n  sid=None\n  for phase in ('cold','resume'):\n   stem=f'{server_route}.{role}.{phase}';shared=root/(role+'.'+phase+'.source.json');nonce=json.loads(shared.read_text())['nonce'] if shared.exists() else secrets.token_hex(16)\n   source_path=shared;source_path.write_text(json.dumps({'nonce':nonce})+'\\n')\n   task='Call agent_cli.read_text_file(path='+json.dumps(str(source_path))+') exactly once this turn. Parse the JSON in its content and include the exact nonce field value in summary. '\n   if role=='consumer':task+='Return canonical no_action with no proposal or decisions.'\n   else:task+='Return canonical approve for proposal_revision=0 and candidate_digest=\"'+digest+'\", feedback=null.'\n   task+=' This is a native provider compatibility diagnostic with anonymous substitute source, not a business decision or authorization. Do not invoke other diagnostic callbacks.'\n   if role=='audit':task+=' Current fixed anonymous candidate: '+json.dumps(candidate.model_dump(mode='json'),ensure_ascii=False)\n   prompt=native_task_prompt(task,role)\n   configuration=frozen_configurations[role]\n   sections=(consumer_developer_sections(work_profile='',prompt_configuration=configuration) if role=='consumer' else audit_developer_sections(frozen_audit_rules,work_profile='',prompt_configuration=configuration));developer=render_prompt_sections(sections,placement='developer',omit_empty=role=='consumer')\n   if variant=='compact':developer=native_developer_assembly(developer,sections,role).text\n   # Substitute transports only. No service or personal connector is called.\n   with patch('app.codex_runtime_adapter.service_mcp_config_options',lambda:[]):\n    command=adapter.build_command(route,prompt,sid,None,native_output_schema_path(role),True,'on-failure',developer,True,skip_git_repo_check=False,reasoning_effort='medium',skill_names=())\n   insertion=len(command)-1-(1 if sid else 0)\n   for name in tomllib.loads(Path('/Users/derek/.codex/config.toml').read_text()).get('mcp_servers',{}):\n    if name!='agent_cli':command[insertion:insertion]=['-c',f'mcp_servers.{name}.enabled=false'];insertion+=2\n   make_role_agent_command(command,role=role,task_workspace=str(root),controlled_cli=ControlledCliConfig(command='/Users/derek/miniforge3/bin/python',args=(str(root/'server.py'),role,server_route,phase),cwd=str(root)))\n   index=len(command)-1-(1 if sid else 0);command[index:index]=['-c','mcp_servers.agent_cli.enabled=true']\n   if role=='audit':command.insert(-1 if not sid else -2,'--skip-git-repo-check')\n   if route.credential_mode is CredentialMode.SERVICE_API:disable_automatic_review(command)\n   env=adapter.build_env(route)\n   with (root/(stem+'.stdout.jsonl')).open('w') as out,(root/(stem+'.stderr.txt')).open('w') as err:\n    try:proc=subprocess.run(command,input=prompt,text=True,stdout=out,stderr=err,cwd=root,env=env,timeout=180);code=proc.returncode;timeout=False\n    except subprocess.TimeoutExpired:code=None;timeout=True\n   raw=(root/(stem+'.stdout.jsonl')).read_text();events=[json.loads(l) for l in raw.splitlines()];observed=next((x.get('thread_id') for x in events if x.get('type')=='thread.started'),None)\n   try:result=json.loads(parse_native_output(raw,role));error=None\n   except Exception as e:result=None;error=type(e).__name__+': '+str(e)\n   callsfile=root/(stem+'.calls.jsonl');calls=[json.loads(l) for l in callsfile.read_text().splitlines()] if callsfile.exists() else []\n   completed=any(x.get('type')=='turn.completed' for x in events);failed=any(x.get('type')=='turn.failed' for x in events)\n   expected=[x for x in calls if x['expected']];binding=result is not None and (role=='consumer' and result['outcome']=='no_action' and result.get('proposal') is None or role=='audit' and result['outcome']=='approve' and result['proposal_revision']==0 and result['candidate_digest']==digest)\n   passed=code==0 and not timeout and completed and not failed and binding and len(expected)==1 and len(calls)==1 and nonce in result['summary'] 