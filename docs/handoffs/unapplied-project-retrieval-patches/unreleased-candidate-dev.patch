+def _register_context_project(store, resolver, *, ref, title, goal, signal_ids=()):
+    from app.project_context_service import ProjectContextService
+    from app.task_semantic_models import ProjectContext
+
+    anchor = resolver.register_anchor(anchor_type="project", anchor_ref=ref, title=title)
+    project = resolver.register_official_project(anchor_id=anchor, registry_source=f"registry:{ref}")
+    with store.business_task_transaction() as db:
+        ProjectContextService(store).apply(
+            project_id=project,
+            context=ProjectContext(goal=goal, scope="", overall_owner=None, responsibilities=[], facts=[]),
+            signal_ids=signal_ids, db=db,
+        )
+    return anchor, project
+
