+def test_selected_project_anchor_delivers_exact_registry_record_outside_initial_budget(tmp_path):
+    from app.project_context_service import ProjectContextService
+    from app.task_business_resolution import BusinessResolutionService
+
+    store = AutoReplyStore(tmp_path / "anchor-registry.sqlite3")
+    resolver = BusinessResolutionService(store)
+    target_anchor, target_project = _register_context_project(
+        store, resolver, ref="p:target", title="alpha", goal="saved context",
+    )
+    initial_anchor, initial_project = _register_context_project(
+        store, resolver, ref="p:initial", title="beta", goal="alpha beta",
+    )
+    unrelated_anchor = resolver.register_anchor(anchor_type="project", anchor_ref="p:other", title="gamma")
+    unrelated_project = resolver.register_official_project(anchor_id=unrelated_anchor, registry_source="registry:other")
+    signals = [store.create_business_task_signal(
+        source_type="message", source_ref=f"proof:{i}", evidence_text=f"saved detail {i}", dedupe_key=f"proof:{i}",
+    ) for i in range(3)]
+    with store.business_task_transaction() as db:
+        ProjectContextService(store).apply(project_id=target_project, context=None, signal_ids=signals, db=db)
+
+    item = _work_item("alpha beta")
+    context = retrieve_task_semantic_context(store, item, limit_per_kind=1)
+    # Context makes beta the initial Project; alpha is the selected remaining anchor.
