+def test_project_embedded_latin_title_does_not_receive_literal_priority(tmp_path):
+    from app.project_context_service import ProjectContextService
+    from app.task_business_resolution import BusinessResolutionService
+    from app.task_semantic_models import ProjectContext
+
+    store = AutoReplyStore(tmp_path / "embedded-latin-project-title.sqlite3")
+    resolver = BusinessResolutionService(store)
+    projects = []
+    for index, title in enumerate(("AI", "delivery progress budget review planning")):
+        anchor = resolver.register_anchor(
+            anchor_type="project", anchor_ref=f"project:{index}", title=title,
+        )
+        projects.append(resolver.register_official_project(
+            anchor_id=anchor, registry_source=f"registry:{index}",
+        ))
+    # Other context words match, so a positive overall score cannot establish
+    # that the short registered title was mentioned as a complete token.
+    with store.business_task_transaction() as db:
+        ProjectContextService(store).apply(
+            project_id=projects[0],
+            context=ProjectContext(
+                goal="delivery progress", scope="", overall_owner=None,
+                responsibilities=[], facts=[],
+            ),
+            signal_ids=(), db=db,
+        )
+    item = _work_item("TRAIN has delivery progress and budget review planning.")
+
+    context = retrieve_task_semantic_context(store, item, limit_per_kind=1)
+
+    assert [project.id for project in context.official_projects] == [projects[1]]
+
