          "sql": "CREATE TRIGGER trg_runs_child_review_candidates_consumer_run_id_insert before insert on \"review_candidates\" when new.\"consumer_run_id\" is not null and exists(select 1 from runs where id=new.\"consumer_run_id\" and record_type<>'agent_runs') begin select raise(abort,'run parent must be a logical agent run'); end"
