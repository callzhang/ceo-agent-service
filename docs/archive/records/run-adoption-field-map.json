  "source_constraints": {
    "candidate_to_consumer_run": "unique 1:1",
    "review_to_audit_run": "unique 1:1",
    "candidate_to_review": "1:N; no unique candidate constraint",
    "predecessor": "candidate review id resolves to Audit Run",
    "selection": "unique per candidate and exact review; option key only; branch body derived",
    "supplements": "1:N independent identity",
    "execution_progress": "one per Consumer Run; status and lease independent of runs.status",
    "receipt_execution_association": "per receipt FK to run_execution_progress(consumer_run_id); 425 receipt rows map to 424 Action parents and one Action spans two Consumer Runs",
    "observer_run": "preserve action_observers(agent_run_id) unchanged",
    "execution_progress_selection_binding": "execution_review_id and execution_selection_id retain immediate source existence FKs; run_execution_progress.approved_audit_run_id references the existing Audit Review immediately, selection_id references the actual Selection business ID immediately, while deferred composite Consumer/approved-Audit and Selection/Consumer/approved-Audit FKs enforce ownership at COMMIT"
  },
