{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "feedback": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "observation": {"minLength": 1, "type": "string"},
            "requested_revision": {"minLength": 1, "type": "string"},
            "rule": {"minLength": 1, "type": "string"}
          },
          "required": ["rule", "observation", "requested_revision"],
          "type": "object"
        },
        {"type": "null"}
      ]
    },
    "outcome": {
      "enum": ["approve", "return", "reject"],
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": ["outcome", "summary", "feedback"],
  "type": "object"
}
