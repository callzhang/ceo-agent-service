{
  "additionalProperties": false,
  "properties": {
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_retryable": {
      "type": "boolean"
    },
    "error_authorization_required": {
      "type": "boolean"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "rule_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "information_completeness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "outcome": {
      "enum": [
        "approve",
        "return",
        "reject",
        "failed"
      ],
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/_AuditFeedbackWire"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "summary",
    "error_code",
    "error_retryable",
    "error_authorization_required",
    "risk",
    "confidence",
    "rule_coverage",
    "information_completeness",
    "outcome",
    "evidence_refs",
    "feedback"
  ],
  "type": "object",
  "$defs": {
    "CandidateFieldAssertion": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "json_type": {
          "enum": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "value",
        "json_type"
      ],
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/JsonValue"
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "entries"
          ],
          "additionalProperties": false,
          "description": "Lossless JSON object: entries holds each original key and value."
        }
      ]
    },
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "_AuditFeedbackWire": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "type": "string"
        },
        "requested_revision": {
          "minLength": 1,
          "type": "string"
        },
        "observation_basis": {
          "description": "Use candidate_fields for claims about current candidate JSON values, types or paths; business for policy, authority and source judgments.",
          "enum": [
            "business",
            "candidate_fields"
          ],
          "type": "string"
        },
        "candidate_field_assertions": {
          "description": "For candidate_fields, supply the exact candidate-relative path, literal value and JSON type; System checks these before adopting feedback.",
          "items": {
            "$ref": "#/$defs/CandidateFieldAssertion"
          },
          "type": "array"
        }
      },
      "required": [
        "rule",
        "observation",
        "requested_revision",
        "observation_basis",
        "candidate_field_assertions"
      ],
      "type": "object"
    },
    "_AuditWire": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_retryable": {
          "type": "boolean"
        },
        "error_authorization_required": {
          "type": "boolean"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "rule_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "information_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "outcome": {
          "enum": [
            "approve",
            "return",
            "reject",
            "failed"
          ],
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/_AuditFeedbackWire"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "error_code",
        "error_retryable",
        "error_authorization_required",
        "risk",
        "confidence",
        "rule_coverage",
        "information_completeness",
        "outcome",
        "evidence_refs",
        "feedback"
      ],
      "type": "object"
    }
  }
}
