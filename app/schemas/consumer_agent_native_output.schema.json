        },
        "durable_memories": {
          "description": "Before you finish, check whether this turn confirmed anything durable: a person's preference, a decision that was made, a reusable rule or convention, an accepted project rule, a stable business fact, long-term context, or the explicit next step of unfinished work. If it did, list each one as its own item here. Skip temporary tasks, logs, code, one-off errors, unconfirmed guesses, sensitive original text, secrets or tokens, unauthorized document content, and anything already in Memory. An empty list is the right answer when nothing durable came up this turn -- but check every turn, don't default to empty.",
          "items": {
            "$ref": "#/$defs/DurableMemory"
          },
          "type": "array"
        },
        "outcome": {
          "enum": [
            "proposal",
            "needs_human",
