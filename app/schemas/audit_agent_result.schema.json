{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_code": {
          "title": "Source Code",
          "type": "string"
        },
        "session_continuable": {
          "title": "Session Continuable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required",
        "stage",
        "source",
        "source_code",
        "session_continuable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AuditEffectiveReturnAssessment": {
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "items": {
            "$ref": "#/$defs/AuditEffectiveReturnRound"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Rounds",
          "type": "array"
        },
        "current_gap_unresolved": {
          "title": "Current Gap Unresolved",
          "type": "boolean"
        },
        "current_evidence_ref": {
          "minLength": 1,
          "title": "Current Evidence Ref",
          "type": "string"
        },
        "current_evidence_time": {
          "minLength": 1,
          "title": "Current Evidence Time",
          "type": "string"
        },
        "current_unresolved_basis": {
          "minLength": 1,
          "title": "Current Unresolved Basis",
          "type": "string"
        }
      },
      "required": [
        "rounds",
        "current_gap_unresolved",
        "current_evidence_ref",
        "current_evidence_time",
        "current_unresolved_basis"
      ],
      "title": "AuditEffectiveReturnAssessment",
      "type": "object"
    },
    "AuditEffectiveReturnRound": {
      "additionalProperties": false,
      "properties": {
        "return_ref": {
          "minLength": 1,
          "title": "Return Ref",
          "type": "string"
        },
        "return_time": {
          "minLength": 1,
          "title": "Return Time",
          "type": "string"
        },
        "same_gap": {
          "minLength": 1,
          "title": "Same Gap",
          "type": "string"
        },
        "actionable_request": {
          "minLength": 1,
          "title": "Actionable Request",
          "type": "string"
        },
        "responses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AuditReturnResponseEvidence"
          },
          "title": "Responses",
          "type": "array"
        },
        "no_response_readback_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Response Readback Ref"
        },
        "same_gap_unresolved_after_response": {
          "title": "Same Gap Unresolved After Response",
          "type": "boolean"
        }
      },
      "required": [
        "return_ref",
        "return_time",
        "same_gap",
        "actionable_request",
        "same_gap_unresolved_after_response"
      ],
      "title": "AuditEffectiveReturnRound",
      "type": "object"
    },
    "AuditFeedback": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "requested_revision": {
          "minLength": 1,
          "title": "Requested Revision",
          "type": "string"
        },
        "observation_basis": {
          "default": "business",
          "description": "Use candidate_fields for claims about current candidate JSON values, types or paths; business for policy, authority and source judgments.",
          "enum": [
            "business",
            "candidate_fields"
          ],
          "title": "Observation Basis",
          "type": "string"
        },
        "candidate_field_assertions": {
          "default": [],
          "description": "For candidate_fields, supply the exact candidate-relative path, literal value and JSON type; System checks these before adopting feedback.",
          "items": {
            "$ref": "#/$defs/CandidateFieldAssertion"
          },
          "title": "Candidate Field Assertions",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "observation",
        "requested_revision"
      ],
      "title": "AuditFeedback",
      "type": "object"
    },
    "AuditOutcome": {
      "enum": [
        "approve",
        "return",
        "reject",
        "failed"
      ],
      "title": "AuditOutcome",
      "type": "string"
    },
    "AuditReturnResponseEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_time": {
          "minLength": 1,
          "title": "Source Time",
          "type": "string"
        },
        "response_type": {
          "enum": [
            "applicant_reply",
            "approver_comment",
            "attachment",
            "other"
          ],
          "title": "Response Type",
          "type": "string"
        },
        "substantive_summary": {
          "minLength": 1,
          "title": "Substantive Summary",
          "type": "string"
        },
        "cures_same_gap": {
          "title": "Cures Same Gap",
          "type": "boolean"
        }
      },
      "required": [
        "source_ref",
        "source_time",
        "response_type",
        "substantive_summary",
        "cures_same_gap"
      ],
      "title": "AuditReturnResponseEvidence",
      "type": "object"
    },
    "CandidateFieldAssertion": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "minItems": 1,
          "title": "Path",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "json_type": {
          "enum": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ],
          "title": "Json Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value",
        "json_type"
      ],
      "title": "CandidateFieldAssertion",
      "type": "object"
    },
    "JsonValue": {},
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "approve"
        },
        "feedback": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "return"
        },
        "feedback": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "reject"
        },
        "feedback": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "failed"
        },
        "feedback": {
          "type": "null"
        }
      }
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal_revision": {
      "minimum": 0,
      "title": "Proposal Revision",
      "type": "integer"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "oa_effective_return_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditEffectiveReturnAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required when approving an OA rejection whose rationale relies on three effective returns for the same gap. Include all three timestamped rounds, every post-return response or a complete negative readback reference, cure judgments and current unresolved evidence; cite every reference in evidence_refs."
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditFeedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "rule_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rule Coverage",
      "type": "number"
    },
    "information_completeness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Information Completeness",
      "type": "number"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "candidate_digest",
    "feedback",
    "error",
    "risk",
    "confidence",
    "rule_coverage",
    "information_completeness"
  ],
  "title": "AuditAgentResult",
  "type": "object"
}
