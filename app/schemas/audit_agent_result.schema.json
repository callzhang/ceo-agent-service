{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_code": {
          "title": "Source Code",
          "type": "string"
        },
        "session_continuable": {
          "title": "Session Continuable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required",
        "stage",
        "source",
        "source_code",
        "session_continuable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AuditFeedback": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "requested_revision": {
          "minLength": 1,
          "title": "Requested Revision",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "observation",
        "requested_revision"
      ],
      "title": "AuditFeedback",
      "type": "object"
    },
    "AuditOutcome": {
      "enum": [
        "approve",
        "return",
        "reject",
        "failed"
      ],
      "title": "AuditOutcome",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "approve"
        },
        "feedback": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "return"
        },
        "feedback": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "reject"
        },
        "feedback": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "failed"
        },
        "feedback": {
          "type": "null"
        }
      }
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal_revision": {
      "minimum": 0,
      "title": "Proposal Revision",
      "type": "integer"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditFeedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "rule_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rule Coverage",
      "type": "number"
    },
    "information_completeness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Information Completeness",
      "type": "number"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "candidate_digest",
    "feedback",
    "error",
    "risk",
    "confidence",
    "rule_coverage",
    "information_completeness"
  ],
  "title": "AuditAgentResult",
  "type": "object"
}
