{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AuditExternalResult": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "verification_summary": {
          "minLength": 1,
          "title": "Verification Summary",
          "type": "string"
        },
        "live_result_reference": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Live Result Reference",
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "verification_summary",
        "live_result_reference"
      ],
      "title": "AuditExternalResult",
      "type": "object"
    },
    "AuditFeedback": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "requested_revision": {
          "minLength": 1,
          "title": "Requested Revision",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "observation",
        "requested_revision"
      ],
      "title": "AuditFeedback",
      "type": "object"
    },
    "AuditOutcome": {
      "enum": [
        "executed",
        "feedback_provided",
        "needs_human",
        "dry_run",
        "failed"
      ],
      "title": "AuditOutcome",
      "type": "string"
    },
    "AuditReconciliation": {
      "additionalProperties": false,
      "properties": {
        "action_index": {
          "minimum": 0,
          "title": "Action Index",
          "type": "integer"
        },
        "disposition": {
          "$ref": "#/$defs/ReconciliationDisposition"
        },
        "read_result_digest": {
          "minLength": 1,
          "title": "Read Result Digest",
          "type": "string"
        }
      },
      "required": [
        "action_index",
        "disposition",
        "read_result_digest"
      ],
      "title": "AuditReconciliation",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "One actionable, mutually exclusive instruction for a real management choice.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "consequence": {
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "instruction",
        "consequence"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "JsonValue": {},
    "ReconciliationDisposition": {
      "enum": [
        "present",
        "absent",
        "superseded",
        "ambiguous"
      ],
      "title": "ReconciliationDisposition",
      "type": "string"
    },
    "SideEffectState": {
      "enum": [
        "none",
        "confirmed",
        "unknown"
      ],
      "title": "SideEffectState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "outcome": {
          "const": "executed"
        },
        "side_effect_state": {
          "const": "confirmed"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "object"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "feedback_provided"
        },
        "side_effect_state": {
          "const": "none"
        },
        "feedback": {
          "type": "object"
        },
        "external_result": {
          "type": "null"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "failed"
        },
        "side_effect_state": {
          "const": "none"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "needs_human"
        },
        "side_effect_state": {
          "const": "none"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "dry_run"
        },
        "side_effect_state": {
          "const": "none"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        }
      },
      "type": "object"
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal_revision": {
      "minimum": 0,
      "title": "Proposal Revision",
      "type": "integer"
    },
    "side_effect_state": {
      "$ref": "#/$defs/SideEffectState"
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditFeedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditExternalResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "reconciliation": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuditReconciliation"
      },
      "title": "Reconciliation",
      "type": "array"
    },
    "decision_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Decision Options",
      "type": "array"
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "side_effect_state",
    "feedback",
    "external_result",
    "error"
  ],
  "title": "AuditAgentResult",
  "type": "object"
}
