{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_code": {
          "title": "Source Code",
          "type": "string"
        },
        "session_continuable": {
          "title": "Session Continuable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required",
        "stage",
        "source",
        "source_code",
        "session_continuable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AuditExternalResult": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "verification_summary": {
          "minLength": 1,
          "title": "Verification Summary",
          "type": "string"
        },
        "live_result_reference": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Live Result Reference",
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "verification_summary",
        "live_result_reference"
      ],
      "title": "AuditExternalResult",
      "type": "object"
    },
    "AuditFeedback": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "requested_revision": {
          "minLength": 1,
          "title": "Requested Revision",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "observation",
        "requested_revision"
      ],
      "title": "AuditFeedback",
      "type": "object"
    },
    "AuditOutcome": {
      "enum": [
        "executed",
        "feedback_provided",
        "needs_human",
        "dry_run",
        "failed"
      ],
      "title": "AuditOutcome",
      "type": "string"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "One actionable, mutually exclusive instruction for a real management choice.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "consequence": {
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "instruction",
        "consequence"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "JsonValue": {},
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "outcome": {
          "const": "executed"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "object"
        }
      },
      "required": [
        "outcome",
        "feedback",
        "external_result"
      ],
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "feedback_provided"
        },
        "feedback": {
          "type": "object"
        },
        "external_result": {
          "type": "null"
        }
      },
      "required": [
        "outcome",
        "feedback",
        "external_result"
      ],
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "failed"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        }
      },
      "required": [
        "outcome",
        "feedback",
        "external_result"
      ],
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "needs_human"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        },
        "decision_options": {
          "maxItems": 4,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "feedback",
        "external_result",
        "decision_options"
      ],
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "const": "dry_run"
        },
        "feedback": {
          "type": "null"
        },
        "external_result": {
          "type": "null"
        }
      },
      "required": [
        "outcome",
        "feedback",
        "external_result"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal_revision": {
      "minimum": 0,
      "title": "Proposal Revision",
      "type": "integer"
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditFeedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditExternalResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Decision Options",
      "type": "array"
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "feedback",
    "external_result",
    "error",
    "risk",
    "confidence"
  ],
  "title": "AuditAgentResult",
  "type": "object"
}
