{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_code": {
          "title": "Source Code",
          "type": "string"
        },
        "session_continuable": {
          "title": "Session Continuable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required",
        "stage",
        "source",
        "source_code",
        "session_continuable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "ConsumerOutcome": {
      "enum": [
        "proposal",
        "no_action",
        "needs_human",
        "failed"
      ],
      "title": "ConsumerOutcome",
      "type": "string"
    },
    "ConsumerProposal": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ProposedAction"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "sourced_facts": {
          "items": {
            "$ref": "#/$defs/ProposalFact"
          },
          "title": "Sourced Facts",
          "type": "array"
        },
        "authored_judgment": {
          "title": "Authored Judgment",
          "type": "string"
        }
      },
      "required": [
        "objective",
        "actions",
        "sourced_facts",
        "authored_judgment"
      ],
      "title": "ConsumerProposal",
      "type": "object"
    },
    "DecisionBasis": {
      "additionalProperties": false,
      "description": "The compact evidence chain a person needs to assess an escalation.",
      "properties": {
        "verified_facts": {
          "items": {
            "$ref": "#/$defs/ProposalFact"
          },
          "minItems": 1,
          "title": "Verified Facts",
          "type": "array"
        },
        "rule_evidence": {
          "items": {
            "$ref": "#/$defs/ProposalFact"
          },
          "minItems": 1,
          "title": "Rule Evidence",
          "type": "array"
        },
        "quality_explanation": {
          "minLength": 1,
          "title": "Quality Explanation",
          "type": "string"
        },
        "no_external_action_evidence": {
          "items": {
            "$ref": "#/$defs/ProposalFact"
          },
          "minItems": 1,
          "title": "No External Action Evidence",
          "type": "array"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        }
      },
      "required": [
        "verified_facts",
        "rule_evidence",
        "quality_explanation",
        "no_external_action_evidence",
        "conclusion"
      ],
      "title": "DecisionBasis",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "One bound choice for the current business instance.",
      "oneOf": [
        {
          "properties": {
            "plan": {
              "type": "object"
            },
            "terminal_outcome": {
              "type": "null"
            },
            "reason": {
              "type": "null"
            }
          },
          "required": [
            "plan"
          ]
        },
        {
          "properties": {
            "plan": {
              "type": "null"
            },
            "terminal_outcome": {
              "const": "skipped"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "terminal_outcome",
            "reason"
          ]
        }
      ],
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "consequence": {
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsumerProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "terminal_outcome": {
          "anyOf": [
            {
              "const": "skipped",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Outcome"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "key",
        "label",
        "instruction",
        "consequence"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DurableMemory": {
      "additionalProperties": false,
      "description": "Only information this turn confirmed that should outlive it: a person's preference, a decision that was made, a reusable rule or convention, a stable business fact, or the explicit next step of unfinished work. Never temporary tasks, logs, code, one-off errors, unconfirmed guesses, sensitive original text, secrets or tokens, unauthorized document content, or anything already in Memory. Name people by name, never 'the user'.",
      "properties": {
        "title": {
          "description": "One-line title.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "description": "One to three sentences of plain language about one thing.",
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "source_time": {
          "description": "ISO-8601 time the information arose in its source (the message, meeting or document), not the time of this turn.",
          "minLength": 1,
          "title": "Source Time",
          "type": "string"
        },
        "source_refs": {
          "description": "Where it came from: message ids, document links, approval ids.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurableMemorySubject"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The main person, project, customer or organization."
        }
      },
      "required": [
        "title",
        "content",
        "source_time",
        "source_refs"
      ],
      "title": "DurableMemory",
      "type": "object"
    },
    "DurableMemorySubject": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Person",
            "Project",
            "Customer",
            "Organization"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "DurableMemorySubject",
      "type": "object"
    },
    "JsonValue": {},
    "ProposalFact": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "assertion",
        "references"
      ],
      "title": "ProposalFact",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "dingtalk-oa"
              },
              "operation": {
                "enum": [
                  "approve",
                  "reject",
                  "revert_task",
                  "redirect_task",
                  "comment"
                ]
              }
            },
            "required": [
              "capability",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "process_instance_id": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "process_instance_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "dingtalk-oa"
              },
              "operation": {
                "enum": [
                  "approve",
                  "reject",
                  "revert_task",
                  "redirect_task"
                ]
              }
            },
            "required": [
              "capability",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "task_id": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "task_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "dingtalk-oa"
              },
              "operation": {
                "enum": [
                  "revert_task"
                ]
              }
            },
            "required": [
              "capability",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "target_activity_id": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "target_activity_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "dingtalk-oa"
              },
              "operation": {
                "enum": [
                  "redirect_task"
                ]
              }
            },
            "required": [
              "capability",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "to_actioner_id": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "to_actioner_id"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "action_identity": {
          "minLength": 1,
          "title": "Action Identity",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "Target",
          "type": "object"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "effect": {
          "default": "external",
          "description": "external when performing this action changes something outside the service and a provider must accept it; none when it changes nothing -- a verification, or a state already in place. An action that carries a message body is always external.",
          "enum": [
            "external",
            "none"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "description",
        "action_identity",
        "capability",
        "operation",
        "target",
        "payload"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "ReviewedSourceBinding": {
      "additionalProperties": false,
      "description": "Provider facts captured by the service before the candidate is reviewed.",
      "properties": {
        "provider": {
          "enum": [
            "task_context",
            "dingtalk-oa",
            "dingtalk-doc",
            "dingtalk-message-resource"
          ],
          "title": "Provider",
          "type": "string"
        },
        "object_ref": {
          "minLength": 1,
          "title": "Object Ref",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "provider",
        "object_ref",
        "value"
      ],
      "title": "ReviewedSourceBinding",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "proposal"
        },
        "proposal": {
          "type": "object"
        },
        "decision_options": {
          "maxItems": 0,
          "type": "array"
        },
        "requested_input": {
          "type": "null"
        },
        "needs_human_reason": {
          "type": "null"
        },
        "decision_basis": {
          "type": "null"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "enum": [
            "no_action",
            "failed"
          ]
        },
        "proposal": {
          "type": "null"
        },
        "decision_options": {
          "maxItems": 0,
          "type": "array"
        },
        "requested_input": {
          "type": "null"
        },
        "needs_human_reason": {
          "type": "null"
        },
        "decision_basis": {
          "type": "null"
        }
      },
      "type": "object"
    },
    {
      "oneOf": [
        {
          "properties": {
            "decision_options": {
              "maxItems": 4,
              "minItems": 2,
              "type": "array"
            },
            "requested_input": {
              "type": "null"
            }
          },
          "required": [
            "decision_options"
          ]
        },
        {
          "properties": {
            "decision_options": {
              "maxItems": 0,
              "type": "array"
            },
            "requested_input": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "decision_options",
            "requested_input"
          ]
        }
      ],
      "properties": {
        "outcome": {
          "const": "needs_human"
        },
        "proposal": {
          "type": "null"
        },
        "decision_options": {
          "maxItems": 4,
          "type": "array"
        },
        "needs_human_reason": {
          "minLength": 1,
          "type": "string"
        },
        "decision_basis": {
          "type": "object"
        }
      },
      "required": [
        "outcome",
        "proposal",
        "decision_options",
        "needs_human_reason",
        "decision_basis"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/ConsumerOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsumerProposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Decision Options",
      "type": "array"
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "rule_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rule Coverage",
      "type": "number"
    },
    "information_completeness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Information Completeness",
      "type": "number"
    },
    "needs_human_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Needs Human Reason"
    },
    "decision_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionBasis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requested_input": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Input"
    },
    "stage_index": {
      "default": 0,
      "minimum": 0,
      "title": "Stage Index",
      "type": "integer"
    },
    "predecessor_review_id": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Review Id"
    },
    "continue_after_execution": {
      "default": false,
      "title": "Continue After Execution",
      "type": "boolean"
    },
    "source_bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewedSourceBinding"
      },
      "title": "Source Bindings",
      "type": "array"
    },
    "durable_memories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DurableMemory"
      },
      "title": "Durable Memories",
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal",
    "error",
    "risk",
    "confidence",
    "rule_coverage",
    "information_completeness"
  ],
  "title": "ConsumerAgentResult",
  "type": "object"
}
