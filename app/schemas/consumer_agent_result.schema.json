{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "authorization_required": {
          "title": "Authorization Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "authorization_required"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "ConsumerOutcome": {
      "enum": [
        "proposal",
        "no_action",
        "needs_human",
        "failed"
      ],
      "title": "ConsumerOutcome",
      "type": "string"
    },
    "ConsumerProposal": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ProposedAction"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "sourced_facts": {
          "items": {
            "$ref": "#/$defs/ProposalFact"
          },
          "title": "Sourced Facts",
          "type": "array"
        },
        "authored_judgment": {
          "title": "Authored Judgment",
          "type": "string"
        }
      },
      "required": [
        "objective",
        "actions",
        "sourced_facts",
        "authored_judgment"
      ],
      "title": "ConsumerProposal",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "One actionable, mutually exclusive instruction for a real management choice.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "consequence": {
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "instruction",
        "consequence"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "JsonValue": {},
    "ProposalFact": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "assertion",
        "references"
      ],
      "title": "ProposalFact",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "Target",
          "type": "object"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "expected_verification": {
          "minLength": 1,
          "title": "Expected Verification",
          "type": "string"
        }
      },
      "required": [
        "description",
        "capability",
        "operation",
        "target",
        "payload",
        "expected_verification"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Estimated consequence if the proposed result is acted on incorrectly.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "outcome": {
          "const": "proposal"
        },
        "proposal": {
          "type": "object"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "outcome": {
          "enum": [
            "no_action",
            "needs_human",
            "failed"
          ]
        },
        "proposal": {
          "type": "null"
        }
      },
      "type": "object"
    }
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/ConsumerOutcome"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsumerProposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Decision Options",
      "type": "array"
    },
    "error": {
      "$ref": "#/$defs/AgentError"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal",
    "error",
    "risk",
    "confidence"
  ],
  "title": "ConsumerAgentResult",
  "type": "object"
}
