{
  "$defs": {
    "CompletionFollowUpChange": {
      "additionalProperties": false,
      "properties": {
        "follow_up_id": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "todo_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "suppress",
            "close",
            "reschedule",
            "reassign",
            "keep_open"
          ],
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_check": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {},
              "required": [],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_due_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_evidence": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {},
              "required": [],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "follow_up_id",
        "todo_id",
        "action",
        "reason",
        "evidence_check",
        "next_due_at",
        "owner_user_id",
        "owner_name",
        "owner_evidence"
      ],
      "type": "object"
    },
    "CompletionSearchTrace": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit_call_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_kind",
        "result",
        "source_ref",
        "reason",
        "source_created_at",
        "retrieved_at",
        "audit_call_ids"
      ],
      "type": "object"
    },
    "CompletionTodoChange": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "close",
          "type": "string"
        },
        "todo_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "business_task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_evidence": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "action",
        "todo_id",
        "business_task_id",
        "completion_evidence"
      ],
      "type": "object"
    },
    "DecisionRisk": {
      "description": "The estimated consequence of acting on an incorrect result.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "FormalTaskBasis": {
      "enum": [
        "explicit_commitment",
        "explicit_assignment",
        "external_todo",
        "meeting_action_item"
      ],
      "type": "string"
    },
    "ProjectCandidateProposal": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "title",
        "reason"
      ],
      "type": "object"
    },
    "ProjectContext": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "overall_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectResponsibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibilities": {
          "items": {
            "$ref": "#/$defs/ProjectResponsibility"
          },
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/ProjectFact"
          },
          "type": "array"
        }
      },
      "required": [
        "goal",
        "scope",
        "overall_owner",
        "responsibilities",
        "facts"
      ],
      "type": "object"
    },
    "ProjectDecision": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectContext"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete current Project snapshot with original proof for each role/fact. Keep unchanged historical citations; null only adds evidence and does not replace context."
        },
        "crm_customer_label": {
          "anyOf": [
            {
              "description": "Customer name/alias stated in source evidence, never extracted only by guessing from a Project title.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "crm_customer_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCitation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact source citation that explicitly identifies crm_customer_label. CRM identity is resolved separately by read-only exact lookup."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "type": "array"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "anchor_id",
        "registration",
        "context",
        "crm_customer_label",
        "crm_customer_evidence",
        "evidence",
        "reason"
      ],
      "type": "object"
    },
    "ProjectFact": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "type": "array"
        },
        "date_type": {
          "type": "string"
        },
        "date_value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "evidence",
        "date_type",
        "date_value"
      ],
      "type": "object"
    },
    "ProjectProposal": {
      "additionalProperties": false,
      "description": "Adopt the current authoritative Project definition and register or reuse its identity.",
      "properties": {
        "title": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_excerpt": {
          "description": "Exact current authoritative Project definition to register or reuse, distinct from the Task's action evidence; its source-named title takes precedence over a different stored similar or shorter name.",
          "type": "string"
        },
        "authority": {
          "enum": [
            "management_weekly_report",
            "project_weekly_report",
            "department_weekly_report",
            "meeting_decision"
          ],
          "type": "string"
        }
      },
      "required": [
        "title",
        "reason",
        "source_excerpt",
        "authority"
      ],
      "type": "object"
    },
    "ProjectResponsibility": {
      "additionalProperties": false,
      "properties": {
        "person_user_id": {
          "type": "string"
        },
        "person_name": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "person_user_id",
        "person_name",
        "responsibility",
        "evidence"
      ],
      "type": "object"
    },
    "ProjectSelector": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_decision_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Zero-based position in this result's project_decisions, never task_decisions or a persisted ID."
        }
      },
      "type": "object",
      "required": [
        "anchor_id",
        "project_decision_index"
      ]
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "source_excerpt": {
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "source_ref",
        "source_excerpt"
      ],
      "type": "object"
    },
    "TaskAnchorMatchProposal": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "anchor_id",
        "reason"
      ],
      "type": "object"
    },
    "TaskAttentionEvidence": {
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "source_excerpt": {
          "description": "A contiguous verbatim source quote, preserving punctuation, spaces, and line breaks. Do not join separate spans or paraphrase; use separate evidence entries for separate spans.",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "source_ref",
        "source_excerpt"
      ],
      "type": "object"
    },
    "TaskAttentionProposal": {
      "additionalProperties": false,
      "properties": {
        "assessment_basis": {
          "description": "current_observation asserts only current-source facts, not confirmation of history merely retold there. historical_comparison relies on comparison, continuity, escalation or conflict with stored history and requires current null-ID evidence plus positive persisted-ID original evidence. When the current source explicitly compares earlier facts and matching original Signals are delivered, verify that comparison against the originals and use historical_comparison. If the originals are unavailable, mark the comparison uncertain and assert only current facts; never invent historical evidence.",
          "enum": [
            "current_observation",
            "historical_comparison"
          ],
          "type": "string"
        },
        "category": {
          "enum": [
            "fyi",
            "watch",
            "decision",
            "push"
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "why_attention": {
          "type": "string"
        },
        "current_state": {
          "description": "Project-level risk facts, not per-Task action summaries. This proposal belongs to one Project assessment, not each supporting Task.",
          "type": "string"
        },
        "ceo_action": {
          "type": "string"
        },
        "material_trigger": {
          "enum": [
            "threatened_commitment",
            "material_change",
            "material_dispute",
            "ceo_decision",
            "ceo_push",
            "required_gate",
            "risk_escalation"
          ],
          "type": "string"
        },
        "evidence": {
          "description": "Exact original citations covering the actual assessment claims; historical comparison cites relevant original persisted Signals alongside current evidence, not all retrieved sources.",
          "items": {
            "$ref": "#/$defs/TaskAttentionEvidence"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "assessment_basis",
        "category",
        "title",
        "why_attention",
        "current_state",
        "ceo_action",
        "material_trigger",
        "evidence"
      ],
      "type": "object"
    },
    "TaskClusterProposal": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object",
      "required": [
        "cluster_id",
        "title",
        "task_ids",
        "reason"
      ]
    },
    "TaskDateEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "assigned_at",
            "requested_deadline_at",
            "external_deadline_at",
            "committed_deadline_at",
            "estimated_deadline_at",
            "next_check_at"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "description": "Normalized value must equal the complete parseable date phrase quoted in source_excerpt; otherwise preserve source wording without typed date_evidence. Do not move Project registry deadlines onto Tasks.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "source_excerpt": {
          "description": "Quote only the complete parseable date phrase, not a whole registry row or surrounding action prose.",
          "type": "string"
        },
        "actor_user_id": {
          "anyOf": [
            {
              "description": "For source-derived dates use trusted WorkItem.context.sender_user_id; next_check_at uses task-agent. Without trusted sender identity omit typed date_evidence.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_name": {
          "anyOf": [
            {
              "description": "Use trusted WorkItem.context.sender; next_check_at uses CEO Agent. Report/document names are not date actors.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "source_ref",
        "source_excerpt",
        "actor_user_id",
        "actor_name"
      ],
      "type": "object"
    },
    "TaskDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Create/record only independently completable deliverables. Scope/content additions to an existing deliverable update that Task by its real ID, not a second Task; identical quotes alone do not establish identity.",
          "enum": [
            "skip",
            "record_candidate",
            "create_task",
            "update_task"
          ],
          "type": "string"
        },
        "transition": {
          "enum": [
            "none",
            "promote_candidate",
            "apply_acceptance",
            "update_fields",
            "merge_identity"
          ],
          "type": "string"
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Real existing Task ID required for update_task, including an ordinary scope/content update with transition=update_fields. For merge_identity this is the source Task being merged. New/skip decisions leave it null; never put the ordinary update's Task ID only in target_task_id."
        },
        "target_task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Merge destination only: for merge_identity, the distinct existing Task retained after merging task_id into it. Leave null for ordinary update_fields, promotion, acceptance, new or skip decisions."
        },
        "source_excerpt": {
          "anyOf": [
            {
              "description": "Exact contiguous verbatim quote supporting this actual Task action/update or a display-only suggestion's factual basis, not Project registration scope already covered by concrete actions. Project registration belongs in project_decisions. Preserve punctuation, spaces, and line breaks; do not quote an inferred action as human instructions.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_link": {
          "anyOf": [
            {
              "description": "A link to the source (a document, minutes page, message or thread URL). Required whenever the source has one.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_description": {
          "anyOf": [
            {
              "description": "Where a reader can find the source when there is no link, in words: e.g. a DingTalk message is its group and the person who sent it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_group": {
          "anyOf": [
            {
              "description": "The group or conversation the source was said in.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_person": {
          "anyOf": [
            {
              "description": "Who said it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_origin": {
          "anyOf": [
            {
              "description": "Where source_excerpt comes from. current: the Work Item being processed. session: something read earlier in this Agent session. memory: provenance found through memory_recall. For session and memory, source_ref is the ORIGINAL source's reference and source_excerpt an exact quote of its text.",
              "enum": [
                "current",
                "session",
                "memory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "description": "Name the independently completable deliverable; an addition to an existing Task's scope is an update, not a new deliverable. Required nonblank for create_task/record_candidate. Existing-ID updates may omit it or use empty string; a nonempty provided update title must not be whitespace-only. Only update_fields changes a provided title. Promotion, acceptance and merge preserve the stored title.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "description": "Describe this deliverable or the existing Task's actual scope/content update; do not split additions into duplicate Tasks.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "formal_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalTaskBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_polarity": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "declined",
                "ambiguous"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_target_signal_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "open",
                "waiting",
                "done",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "business_relevance": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "not_relevant",
                "relevant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_evidence": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "source_ref": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "source_ref",
                "excerpt"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_kind": {
          "anyOf": [
            {
              "enum": [
                "individual",
                "team",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the source identifies one individual owner, a team, or no resolvable owner. A team is not sufficient for formal Task creation."
        },
        "owner_relation": {
          "anyOf": [
            {
              "enum": [
                "explicit_assignment",
                "self_commitment",
                "meeting_summary_action_item",
                "speaker_only",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the source connects the named owner to the deliverable. speaker_only means the person merely spoke and is not an assignment."
        },
        "date_evidence": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TaskDateEvidence"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_evidence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
