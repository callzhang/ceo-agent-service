              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Indexes"
        },
        "task_ids": {
          "anyOf": [
            {
              "description": "Positive persisted IDs of supporting existing Tasks; never decision positions or guessed IDs.",
              "items": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Ids"
        },
        "attention_proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAttentionProposal"
            },
            {
              "type": "null"
            }
          ]
        }
