{
  "$defs": {
    "CompletionFollowUpChange": {
      "additionalProperties": false,
      "properties": {
        "follow_up_id": {
          "exclusiveMinimum": 0,
          "title": "Follow Up Id",
          "type": "integer"
        },
        "todo_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Todo Id"
        },
        "action": {
          "enum": [
            "suppress",
            "close",
            "reschedule",
            "reassign",
            "keep_open"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "evidence_check": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {},
              "required": [],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Check"
        },
        "next_due_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Due At"
        },
        "owner_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner User Id"
        },
        "owner_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Name"
        },
        "owner_evidence": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {},
              "required": [],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Evidence"
        }
      },
      "required": [
        "follow_up_id",
        "todo_id",
        "action",
        "reason",
        "evidence_check",
        "next_due_at",
        "owner_user_id",
        "owner_name",
        "owner_evidence"
      ],
      "title": "CompletionFollowUpChange",
      "type": "object"
    },
    "CompletionSearchTrace": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Created At"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieved At"
        },
        "audit_call_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Audit Call Ids"
        }
      },
      "required": [
        "source_kind",
        "result",
        "source_ref",
        "reason",
        "source_created_at",
        "retrieved_at",
        "audit_call_ids"
      ],
      "title": "CompletionSearchTrace",
      "type": "object"
    },
    "CompletionTodoChange": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "close",
          "title": "Action",
          "type": "string"
        },
        "todo_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Todo Id"
        },
        "business_task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Task Id"
        },
        "completion_evidence": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "title": "Completion Evidence",
          "type": "object"
        }
      },
      "required": [
        "action",
        "todo_id",
        "business_task_id",
        "completion_evidence"
      ],
      "title": "CompletionTodoChange",
      "type": "object"
    },
    "DecisionRisk": {
      "description": "The estimated consequence of acting on an incorrect result.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "DecisionRisk",
      "type": "string"
    },
    "FormalTaskBasis": {
      "enum": [
        "explicit_commitment",
        "explicit_assignment",
        "external_todo",
        "meeting_action_item"
      ],
      "title": "FormalTaskBasis",
      "type": "string"
    },
    "ProjectCandidateProposal": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "exclusiveMinimum": 0,
          "title": "Cluster Id",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "title",
        "reason"
      ],
      "title": "ProjectCandidateProposal",
      "type": "object"
    },
    "ProjectContext": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "title": "Goal",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "overall_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectResponsibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibilities": {
          "items": {
            "$ref": "#/$defs/ProjectResponsibility"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/ProjectFact"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "scope",
        "overall_owner",
        "responsibilities",
        "facts"
      ],
      "title": "ProjectContext",
      "type": "object"
    },
    "ProjectDecision": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor Id"
        },
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectProposal"
            },
            {
              "type": "null"
            }
          ]
        },
    "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectContext"
            },
            {
              "type": "null"
            }
          ],
      "description": "Complete current Project snapshot with original proof for each role/fact. Keep unchanged historical citations; null only adds evidence and does not replace context."
    },
    "crm_customer_label": {
      "anyOf": [
        {
          "description": "Customer name/alias stated in source evidence, never extracted only by guessing from a Project title.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Crm Customer Label"
    },
    "crm_customer_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceCitation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact source citation that explicitly identifies crm_customer_label. CRM identity is resolved separately by read-only exact lookup."
    },
    "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
    "anchor_id",
    "registration",
    "context",
    "crm_customer_label",
    "crm_customer_evidence",
    "evidence",
        "reason"
      ],
      "title": "ProjectDecision",
      "type": "object"
    },
    "ProjectFact": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "date_type": {
          "title": "Date Type",
          "type": "string"
        },
        "date_value": {
          "title": "Date Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "evidence",
        "date_type",
        "date_value"
      ],
      "title": "ProjectFact",
      "type": "object"
    },
    "ProjectProposal": {
      "additionalProperties": false,
      "description": "Adopt the current authoritative Project definition and register or reuse its identity.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_excerpt": {
          "description": "Exact current authoritative Project definition to register or reuse, distinct from the Task's action evidence; its source-named title takes precedence over a different stored similar or shorter name.",
          "title": "Source Excerpt",
          "type": "string"
        },
        "authority": {
          "enum": [
            "management_weekly_report",
            "project_weekly_report",
            "department_weekly_report",
            "meeting_decision"
          ],
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "title",
        "reason",
        "source_excerpt",
        "authority"
      ],
      "title": "ProjectProposal",
      "type": "object"
    },
    "ProjectResponsibility": {
      "additionalProperties": false,
      "properties": {
        "person_user_id": {
          "title": "Person User Id",
          "type": "string"
        },
        "person_name": {
          "title": "Person Name",
          "type": "string"
        },
        "responsibility": {
          "title": "Responsibility",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "person_user_id",
        "person_name",
        "responsibility",
        "evidence"
      ],
      "title": "ProjectResponsibility",
      "type": "object"
    },
    "ProjectSelector": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor Id"
        },
        "project_decision_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Zero-based position in this result's project_decisions, never task_decisions or a persisted ID.",
          "title": "Project Decision Index"
        }
      },
      "title": "ProjectSelector",
      "type": "object",
      "required": [
        "anchor_id",
        "project_decision_index"
      ]
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signal Id"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_excerpt": {
          "title": "Source Excerpt",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "source_ref",
        "source_excerpt"
      ],
      "title": "SourceCitation",
      "type": "object"
    },
    "TaskAnchorMatchProposal": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "exclusiveMinimum": 0,
          "title": "Anchor Id",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "anchor_id",
        "reason"
      ],
      "title": "TaskAnchorMatchProposal",
      "type": "object"
    },
    "TaskAttentionEvidence": {
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signal Id"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_excerpt": {
          "description": "A contiguous verbatim source quote, preserving punctuation, spaces, and line breaks. Do not join separate spans or paraphrase; use separate evidence entries for separate spans.",
          "title": "Source Excerpt",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "source_ref",
        "source_excerpt"
      ],
      "title": "TaskAttentionEvidence",
      "type": "object"
    },
    "TaskAttentionProposal": {
      "additionalProperties": false,
      "properties": {
        "assessment_basis": {
          "description": "current_observation asserts only current-source facts, not confirmation of history merely retold there. historical_comparison relies on comparison, continuity, escalation or conflict with stored history and requires current null-ID evidence plus positive persisted-ID original evidence. When the current source explicitly compares earlier facts and matching original Signals are delivered, verify that comparison against the originals and use historical_comparison. If the originals are unavailable, mark the comparison uncertain and assert only current facts; never invent historical evidence.",
          "enum": [
            "current_observation",
            "historical_comparison"
          ],
          "title": "Assessment Basis",
          "type": "string"
        },
        "category": {
          "enum": [
            "fyi",
            "watch",
            "decision",
            "push"
          ],
          "title": "Category",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "why_attention": {
          "title": "Why Attention",
          "type": "string"
        },
        "current_state": {
          "description": "Project-level risk facts, not per-Task action summaries. This proposal belongs to one Project assessment, not each supporting Task.",
          "title": "Current State",
          "type": "string"
        },
        "ceo_action": {
          "title": "Ceo Action",
          "type": "string"
        },
        "material_trigger": {
          "enum": [
            "threatened_commitment",
            "material_change",
            "material_dispute",
            "ceo_decision",
            "ceo_push",
            "required_gate",
            "risk_escalation"
          ],
          "title": "Material Trigger",
          "type": "string"
        },
        "evidence": {
          "description": "Exact original citations covering the actual assessment claims; historical comparison cites relevant original persisted Signals alongside current evidence, not all retrieved sources.",
          "items": {
            "$ref": "#/$defs/TaskAttentionEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_basis",
        "category",
        "title",
        "why_attention",
        "current_state",
        "ceo_action",
        "material_trigger",
        "evidence"
      ],
      "title": "TaskAttentionProposal",
      "type": "object"
    },
    "TaskClusterProposal": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "task_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Ids"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "title": "TaskClusterProposal",
      "type": "object",
      "required": [
        "cluster_id",
        "title",
        "task_ids",
        "reason"
      ]
    },
    "TaskDateEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "assigned_at",
            "requested_deadline_at",
            "external_deadline_at",
            "committed_deadline_at",
            "estimated_deadline_at",
            "next_check_at"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "description": "Normalized value must equal the complete parseable date phrase quoted in source_excerpt; otherwise preserve source wording without typed date_evidence. Do not move Project registry deadlines onto Tasks.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_excerpt": {
          "description": "Quote only the complete parseable date phrase, not a whole registry row or surrounding action prose.",
          "title": "Source Excerpt",
          "type": "string"
        },
        "actor_user_id": {
          "anyOf": [
            {
              "description": "For source-derived dates use trusted WorkItem.context.sender_user_id; next_check_at uses task-agent. Without trusted sender identity omit typed date_evidence.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor User Id"
        },
        "actor_name": {
          "anyOf": [
            {
              "description": "Use trusted WorkItem.context.sender; next_check_at uses CEO Agent. Report/document names are not date actors.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Name"
        }
      },
      "required": [
        "kind",
        "value",
        "source_ref",
        "source_excerpt",
        "actor_user_id",
        "actor_name"
      ],
      "title": "TaskDateEvidence",
      "type": "object"
    },
    "TaskDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Create/record only independently completable deliverables. Scope/content additions to an existing deliverable update that Task by its real ID, not a second Task; identical quotes alone do not establish identity.",
          "enum": [
            "skip",
            "record_candidate",
            "create_task",
            "update_task"
          ],
          "title": "Action",
          "type": "string"
        },
        "transition": {
          "enum": [
            "none",
            "promote_candidate",
            "apply_acceptance",
            "update_fields",
            "merge_identity"
          ],
          "title": "Transition",
          "type": "string"
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skip Reason"
        },
        "task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "target_task_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Task Id"
        },
        "source_excerpt": {
          "anyOf": [
            {
              "description": "Exact contiguous verbatim quote supporting this actual Task action/update or a display-only suggestion's factual basis, not Project registration scope already covered by concrete actions. Project registration belongs in project_decisions. Preserve punctuation, spaces, and line breaks; do not quote an inferred action as human instructions.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Excerpt"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
        },
        "source_link": {
          "anyOf": [
            {
              "description": "A link to the source (a document, minutes page, message or thread URL). Required whenever the source has one.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Link"
        },
        "source_description": {
          "anyOf": [
            {
              "description": "Where a reader can find the source when there is no link, in words: e.g. a DingTalk message is its group and the person who sent it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Description"
        },
        "source_group": {
          "anyOf": [
            {
              "description": "The group or conversation the source was said in.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Group"
        },
        "source_person": {
          "anyOf": [
            {
              "description": "Who said it.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Person"
        },
        "evidence_origin": {
          "anyOf": [
            {
              "description": "Where source_excerpt comes from. current: the Work Item being processed. session: something read earlier in this Agent session. memory: provenance found through memory_recall. For session and memory, source_ref is the ORIGINAL source's reference and source_excerpt an exact quote of its text.",
              "enum": [
                "current",
                "session",
                "memory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Origin"
        },
        "title": {
          "anyOf": [
            {
              "description": "Name the independently completable deliverable; an addition to an existing Task's scope is an update, not a new deliverable. Required nonblank for create_task/record_candidate. Existing-ID updates may omit it or use empty string; a nonempty provided update title must not be whitespace-only. Only update_fields changes a provided title. Promotion, acceptance and merge preserve the stored title.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "description": "Describe this deliverable or the existing Task's actual scope/content update; do not split additions into duplicate Tasks.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "formal_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalTaskBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_polarity": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "declined",
                "ambiguous"
              ],
              "type": "string"
