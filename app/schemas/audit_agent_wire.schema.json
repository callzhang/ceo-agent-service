            "disposition": {
              "enum": [
                "present",
                "absent",
                "ambiguous"
              ],
              "title": "ReconciliationDisposition",
              "type": "string"
            },
            "read_result_digest": {
              "minLength": 1,
              "title": "Read Result Digest",
              "type": "string"
            }
          },
          "required": [
            "action_index",
            "disposition",
            "read_result_digest"
          ],
          "title": "AuditReconciliation",
          "type": "object"
        },
        "type": "array"
      },
      "description": "JSON-encoded array of AuditReconciliation entries.",
      "minLength": 1,
      "title": "Reconciliation Json",
      "type": "string"
    },
    "error_code": {
      "title": "Error Code",
      "type": "string"
    },
    "error_retryable": {
      "title": "Error Retryable",
      "type": "boolean"
    },
    "error_authorization_required": {
      "title": "Error Authorization Required",
      "type": "boolean"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "side_effect_state",
    "feedback_json",
    "external_result_json",
    "reconciliation_json",
    "error_code",
    "error_retryable",
    "error_authorization_required"
  ],
  "title": "AuditAgentWireResult",
  "type": "object"
}
