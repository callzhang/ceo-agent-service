      "type": "boolean"
    },
    "error_authorization_required": {
      "title": "Error Authorization Required",
      "type": "boolean"
    }
  },
  "required": [
    "outcome",
    "summary",
    "proposal_revision",
    "side_effect_state",
    "feedback_json",
    "external_result_json",
    "reconciliation_json",
    "error_code",
    "error_retryable",
