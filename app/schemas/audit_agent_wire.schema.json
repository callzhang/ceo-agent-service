    "reconciliation_json": {
      "contentMediaType": "application/json",
      "contentSchema": {
        "$id": "urn:ceo-agent:audit-reconciliation",
        "items": {
          "additionalProperties": false,
          "properties": {
            "action_index": {
              "minimum": 0,
              "title": "Action Index",
              "type": "integer"
