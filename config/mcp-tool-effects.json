{
  "version": 1,
  "tools": [
    {
      "server": "agent_cli",
      "tool": "execute_reviewed_read",
      "effect": "read_only",
      "readback_for": [
        {
          "server": "agent_cli",
          "tool": "execute_reviewed_write",
          "target_match": "shared",
          "operation_match": "registered",
          "operation_relations": [
            {"read": "calendar event get", "write": "calendar event respond"},
            {"read": "chat message list", "write": "chat message send"},
            {"read": "chat +chat-messages", "write": "chat +dm"},
            {"read": "chat +chat-messages", "write": "chat +messages-send"},
            {"read": "chat +chat-messages", "write": "chat +messages-reply"},
            {"read": "chat +chat-messages", "write": "chat message reply"},
            {"read": "chat message reaction list", "write": "chat message reaction add"},
            {
              "read": "mail message verify",
              "write": "mail message reply",
              "identity_matches": [
                {
                  "write_result": "stdout.internetMessageId",
                  "read_target": "internet-message-id",
                  "read_result": "stdout.internetMessageId"
                }
              ],
              "read_result_constraints": [
                {
                  "path": "stdout.sendStatus",
                  "equals": "success",
                  "comparison": "casefold"
                }
              ]
            },
            {"read": "oa approval detail", "write": "oa approval approve"},
            {"read": "oa approval detail", "write": "oa approval comment"},
            {"read": "oa approval detail", "write": "oa approval oa-comments"},
            {
              "read": "app.cli read-oa-approval-detail",
              "write": "oa approval approve"
            },
            {
              "read": "app.cli read-oa-approval-detail",
              "write": "oa approval comment"
            },
            {
              "read": "app.cli read-oa-approval-detail",
              "write": "oa approval oa-comments"
            },
            {"read": "oa approval tasks", "write": "oa approval approve"},
            {"read": "oa approval tasks", "write": "oa approval comment"},
            {"read": "oa approval tasks", "write": "oa approval oa-comments"},
            {"read": "todo task get", "write": "todo task update"}
          ]
        }
      ]
    },
    {
      "server": "agent_cli",
      "tool": "read_skill",
      "effect": "read_only"
    },
    {
      "server": "agent_cli",
      "tool": "read_text_file",
      "effect": "read_only"
    },
    {
      "server": "agent_cli",
      "tool": "read_spreadsheet",
      "effect": "read_only"
    },
    {
      "server": "agent_cli",
      "tool": "execute_reviewed_write",
      "effect": "effectful"
    },
    {
      "server": "memory_connector",
      "tool": "user_get",
      "effect": "read_only"
    },
    {
      "server": "memory_connector",
      "tool": "memory_recall",
      "effect": "read_only"
    },
    {
      "server": "memory_connector",
      "tool": "memory_get",
      "effect": "read_only"
    },
    {
      "server": "memory_connector",
      "tool": "timeline_get",
      "effect": "read_only"
    },
    {
      "server": "memory_connector",
      "tool": "memory_write",
      "effect": "effectful"
    },
    {
      "server": "memory_connector",
      "tool": "document_upload",
      "effect": "effectful"
    },
    {
      "server": "exa",
      "tool": "web_search_exa",
      "effect": "read_only"
    },
    {
      "server": "exa",
      "tool": "web_fetch_exa",
      "effect": "read_only"
    },
    {
      "server": "xiaoqing_interview",
      "tool": "search_candidates",
      "effect": "read_only"
    },
    {
      "server": "xiaoqing_interview",
      "tool": "get_dashboard_stats",
      "effect": "read_only"
    },
    {
      "server": "xiaoqing_interview",
      "tool": "get_interview_context",
      "effect": "read_only",
      "readback_for": [
        {
          "server": "xiaoqing_interview",
          "tool": "upload_interview_result"
        }
      ]
    },
    {
      "server": "xiaoqing_interview",
      "tool": "download_attachment",
      "effect": "read_only"
    },
    {
      "server": "xiaoqing_interview",
      "tool": "list_candidate_interviews",
      "effect": "read_only"
    },
    {
      "server": "xiaoqing_interview",
      "tool": "upload_interview_result",
      "effect": "effectful",
      "dry_run_argument": "dry_run"
    }
  ]
}
